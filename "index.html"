<script>
// LOCALSTORAGE — guardar y restaurar precios
const PRECIO_FIELDS = ['c-maicena','c-harina','c-manteca','c-azucar','c-huevos','c-ddl','c-coco','c-unidades','c-margen','c-objetivo'];

function guardarPrecios() {
  PRECIO_FIELDS.forEach(id => {
    const el = document.getElementById(id);
    if (el) localStorage.setItem('mde_' + id, el.value);
  });
}

function restaurarPrecios() {
  let restaurado = false;
  PRECIO_FIELDS.forEach(id => {
    const val = localStorage.getItem('mde_' + id);
    const el = document.getElementById(id);
    if (val !== null && el) { el.value = val; restaurado = true; }
  });
  if (restaurado) calcCosto();
}

// Agregar guardado automático a cada campo
window.addEventListener('DOMContentLoaded', () => {
  restaurarPrecios();
  PRECIO_FIELDS.forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('input', guardarPrecios);
  });
});

function showTab(id, btn) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + id).classList.add('active');
  btn.classList.add('active');
}

// TIMER
let timerSec = 720, timerRunning = false, timerInterval = null;
function setTimer(m, label, btn) {
  clearInterval(timerInterval); timerRunning = false;
  timerSec = m * 60;
  document.getElementById('timer-display').textContent = fmt(timerSec);
  document.getElementById('timer-label').textContent = label;
  document.getElementById('btn-start').textContent = '▶ Iniciar';
  document.querySelectorAll('.t-pill').forEach(b => b.classList.remove('sel'));
  btn.classList.add('sel');
}
function fmt(s) { return Math.floor(s/60) + ':' + (s%60<10?'0':'') + s%60; }
function startTimer() {
  if (timerRunning) { clearInterval(timerInterval); timerRunning = false; document.getElementById('btn-start').textContent = '▶ Continuar'; return; }
  timerRunning = true;
  document.getElementById('btn-start').textContent = '⏸ Pausar';
  timerInterval = setInterval(() => {
    timerSec--;
    document.getElementById('timer-display').textContent = timerSec > 0 ? fmt(timerSec) : '¡Listo! 🍪';
    if (timerSec <= 0) { clearInterval(timerInterval); timerRunning = false; document.getElementById('btn-start').textContent = '▶ Iniciar'; }
  }, 1000);
}
function resetTimer() {
  clearInterval(timerInterval); timerRunning = false; timerSec = 720;
  document.getElementById('timer-display').textContent = '12:00';
  document.getElementById('btn-start').textContent = '▶ Iniciar';
}

// COSTOS
let precioUnidad = 0;
function calcCosto() {
  const kg = (id, g) => parseFloat(document.getElementById(id).value || 0) * (g / 1000);
  const maicena = kg('c-maicena', 200);
  const harina = kg('c-harina', 100);
  const manteca = kg('c-manteca', 100);
  const azucar = kg('c-azucar', 80);
  const huevos = (parseFloat(document.getElementById('c-huevos').value || 0) / 12) * 2;
  const ddl = kg('c-ddl', 200);
  const coco = kg('c-coco', 60);
  const units = Math.max(1, parseInt(document.getElementById('c-unidades').value) || 20);
  const margen = parseFloat(document.getElementById('c-margen').value || 100) / 100;
  const total = maicena + harina + manteca + azucar + huevos + ddl + coco;
  const porUnidad = total / units;
  const precio = porUnidad * (1 + margen);
  precioUnidad = precio;
  const f = n => '$' + Math.round(n).toLocaleString('es-AR');
  document.getElementById('r-ingr').textContent = f(total);
  document.getElementById('r-unidad').textContent = f(porUnidad);
  document.getElementById('r-precio').textContent = f(precio);
  document.getElementById('e1').textContent = f(porUnidad * 1.5);
  document.getElementById('e2').textContent = f(porUnidad * 2);
  document.getElementById('e3').textContent = f(porUnidad * 2.5);

  // cajas
  const cajas = [
    {nombre:'Unidad individual', cant:1},
    {nombre:'Bolsa x3', cant:3},
    {nombre:'Caja x6 (regalo)', cant:6},
    {nombre:'Caja x12 (corporativa)', cant:12},
    {nombre:'Docena (12 unidades)', cant:12},
  ];
  const cl = document.getElementById('cajas-list');
  cl.innerHTML = cajas.map(c => `
    <div class="caja-row">
      <span class="caja-nombre">${c.nombre}</span>
      <span class="caja-precio">${f(precio * c.cant)}</span>
    </div>`).join('');

  calcRent();
}

function calcRent() {
  const units = Math.max(1, parseInt(document.getElementById('c-unidades').value) || 20);
  const margen = parseFloat(document.getElementById('c-margen').value || 100) / 100;
  const objetivo = parseFloat(document.getElementById('c-objetivo')?.value || 100000);
  const gananciaUnidad = precioUnidad * margen / (1 + margen);
  const gananciaBatch = gananciaUnidad * units;
  const batchesMes = gananciaBatch > 0 ? Math.ceil(objetivo / gananciaBatch) : 0;
  const alfajoresSem = Math.ceil((batchesMes * units) / 4.3);
  const ingresoMes = gananciaBatch * batchesMes;
  const f = n => '$' + Math.round(n).toLocaleString('es-AR');
  const fN = n => n.toLocaleString('es-AR');
  document.getElementById('r-ganancia-batch').textContent = f(gananciaBatch);
  document.getElementById('r-batches').textContent = fN(batchesMes) + ' /mes';
  document.getElementById('r-alfajores-sem').textContent = fN(alfajoresSem);
  document.getElementById('r-ingreso-mes').textContent = f(ingresoMes);
}

calcCosto();

// CHECKLIST
const ITEMS = [
  "Verificar stock de ingredientes","Retirar manteca de heladera (2h antes)",
  "Tamizar maicena y harina juntas","Precalentar horno a 175°C",
  "Preparar placas con papel manteca","Cremar manteca con azúcar impalpable (3–5 min)",
  "Incorporar yemas de a una","Agregar esencia de vainilla",
  "Unir con secos sin sobreamasar","Formar tapitas uniformes (15g c/u)",
  "Llevar al horno — 10 a 15 minutos","Retirar cuando los bordes estén apenas dorados",
  "Enfriar completamente antes de manipular","Rellenar con dulce de leche repostero",
  "Empanizar bordes con coco rallado","Controlar presentación final",
  "Etiquetar, envasar y registrar producción"
];
let checks = new Array(ITEMS.length).fill(false);
function renderChecklist() {
  document.getElementById('checklist').innerHTML = ITEMS.map((t,i) =>
    `<div class="check-item" onclick="toggle(${i})">
      <div class="check-box ${checks[i]?'done':''}"> ${checks[i]?'✓':''}</div>
      <span class="check-text ${checks[i]?'done':''}">${t}</span>
    </div>`).join('');
  const done = checks.filter(Boolean).length;
  document.getElementById('prog-fill').style.width = Math.round(done/ITEMS.length*100)+'%';
  document.getElementById('prog-text').textContent = done+' / '+ITEMS.length;
}
function toggle(i) { checks[i]=!checks[i]; renderChecklist(); }
function resetChecks() { checks = new Array(ITEMS.length).fill(false); renderChecklist(); }
renderChecklist();

function compartir() {
  const txt = '🍪 Hago Alfajores de Maicena artesanales — receta de Mundo Dulce Emprende. ¡Pedidos por acá!';
  if (navigator.share) { navigator.share({title:'Alfajores de Maicena',text:txt}).catch(()=>{}); }
  else { navigator.clipboard.writeText(txt).then(()=>alert('¡Texto copiado al portapapeles!')).catch(()=>alert(txt)); }
}
</script>
